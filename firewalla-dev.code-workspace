{
  "folders": [
    {
      "path": ".",
    },
    {
      "name": "core",
      "path": "../core",
    },
  ],
  "settings": {
    // Workspace scope covers BOTH folders, so this value is what the `core`
    // folder needs: core installed editable from /workspaces/core (2026.11 dev).
    // The firewalla folder overrides it in `.vscode/settings.json`, because its
    // tests must run against the Home Assistant release that
    // pytest-homeassistant-custom-component pins, not core dev. See that file.
    "python.defaultInterpreterPath": "/home/vscode/.local/ha-venv/bin/python",
    // Analyse only files that are actually open. Without this, Pylance walks the
    // whole workspace folder, and the `core` folder alone holds ~23k Python
    // files. The Python editor diagnostics were the smallest share of the
    // problem count, but this keeps Pylance predictable.
    "python.analysis.diagnosticMode": "openFilesOnly",
    // `exclude` removes paths from indexing, but excluded files are STILL
    // analysed when imported transitively (our tests import homeassistant.*).
    // `ignore` suppresses diagnostics that leak in that way, so both are needed.
    "python.analysis.exclude": [
      "**/node_modules",
      "**/__pycache__",
      "**/.*",
      "**/.mypy_cache/**",
      "**/.pytest_cache/**",
      "**/.ruff_cache/**",
      "**/.tmp/**",
      "**/.artifacts/**",
      "**/.captures/**",
      "**/site-packages/**",
      "${workspaceFolder:core}/**",
    ],
    // Absolute paths are NOT valid in these globs; Pylance resolves them against
    // each workspace folder, so `core` must be named via ${workspaceFolder:core}
    // or it is analysed in full.
    "python.analysis.ignore": [
      "**/.tmp/**",
      "**/.artifacts/**",
      "**/.captures/**",
      "${workspaceFolder:core}/**",
    ],
    // The Java problems were the big ones, and they came from a different
    // language server entirely. `.tmp` holds the jadx-decompiled APK: ~41,400
    // .java files. redhat.java did not find a Maven/Gradle project, so it built
    // an "invisible project" (jdt.ls-java-project, src/defpackage) and started
    // COMPILING that decompiled code. Partially decompiled R8 output produces
    // errors by the tens of thousands, which is where the six-figure problem
    // count came from. `java.import.exclusions` is the setting that stops it.
    // Its default value is replaced, not merged, so the stock entries are kept
    // here alongside ours.
    "java.import.exclusions": [
      "**/node_modules/**",
      "**/.metadata/**",
      "**/archetype-resources/**",
      "**/META-INF/maven/**",
      "**/.tmp/**",
      "**/.artifacts/**",
      "**/.captures/**",
    ],
    // Stop watching the large read-only trees so file events do not trigger
    // re-indexing work in any language server.
    "files.watcherExclude": {
      "**/.tmp/**": true,
      "**/.artifacts/**": true,
      "**/.captures/**": true,
      "**/.mypy_cache/**": true,
      "**/.pytest_cache/**": true,
      "**/.ruff_cache/**": true,
      "**/__pycache__/**": true,
      "**/node_modules/**": true,
      "**/.venv/**": true,
      "**/site-packages/**": true,
      "${workspaceFolder:core}/**": true,
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/.*": true,
      "**/.mypy_cache/**": true,
      "**/.pytest_cache/**": true,
      "**/.ruff_cache/**": true,
      "**/.tmp/**": true,
      "**/.artifacts/**": true,
      "**/.captures/**": true,
      "**/site-packages/**": true,
      "/home/vscode/.local/ha-venv": true,
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      // `.tmp` stays visible on purpose: it holds working notes, release drafts
      // and PR bodies that are meant to be read. Only the decompiled-APK trees
      // are excluded — three jadx outputs holding ~41,400 .java files between
      // them, which make the Explorer crawl and are never opened by hand.
      // `git check-ignore` still reports `.tmp/` ignored, so visibility here
      // never risks committing it.
      "**/.tmp/Firewalla_*": true,
      "**/.artifacts": true,
      "**/.captures": true,
      "**/.venv": true,
      "**/site-packages": true,
      "/home/vscode/.local/ha-venv": true,
    },
    "pylint.args": [
      "--ignore-paths=^\\.mypy_cache/.*$,^\\.pytest_cache/.*$,^\\.ruff_cache/.*$,^\\.tmp/.*$,^\\.artifacts/.*$,^\\.captures/.*$,^.*/site-packages/.*$,^/home/vscode/\\.local/ha-venv/.*$,^/workspaces/core/.*$,^poc\\.py$,^utils/poc\\.py$",
    ],
    "pylint.ignorePatterns": [
      "**/.tmp/**/*.py",
      "**/.artifacts/**/*.py",
      "**/.captures/**/*.py",
      "**/site-packages/**/*.py",
      "/home/vscode/.local/ha-venv/**/*.py",
      "/workspaces/core/**/*.py",
      "/workspaces/firewalla-local-ha/poc.py",
      "/workspaces/firewalla-local-ha/utils/poc.py",
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Auto-Link Firewalla Local",
        "type": "shell",
        "command": "mkdir -p /workspaces/core/config/custom_components && touch /workspaces/core/config/custom_components/__init__.py && ln -snf /workspaces/firewalla-local-ha/custom_components/firewalla_local /workspaces/core/config/custom_components/firewalla_local",
        "runOptions": {
          "runOn": "folderOpen",
        },
      },
      // The three validation tasks must NOT rely on `python` from PATH. In this
      // dev container that is /home/vscode/.local/ha-venv, which has core dev
      // (2026.11) installed editable; running the test suite there aborts while
      // loading pytest-homeassistant-custom-component, which imports httpx
      // before Home Assistant can alias it to httpx2. `.venv` is the isolated
      // environment CI builds with `pip install -e ".[dev]"`.
      {
        "label": "Setup test venv",
        "detail": "Create .venv with the HA release the test plugin pins",
        "type": "shell",
        "command": "uv venv .venv --python 3.14 && uv pip install --python .venv/bin/python -e '.[dev]'",
        "options": {
          "cwd": "${workspaceFolder:firewalla-local-ha}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Ruff",
        "type": "shell",
        "command": "${workspaceFolder:firewalla-local-ha}/.venv/bin/python",
        "args": ["-m", "ruff", "check", "."],
        "options": {
          "cwd": "${workspaceFolder:firewalla-local-ha}",
        },
      },
      {
        "label": "MyPy",
        "type": "shell",
        "command": "${workspaceFolder:firewalla-local-ha}/.venv/bin/python",
        "args": ["-m", "mypy", "custom_components/firewalla_local"],
        "options": {
          "cwd": "${workspaceFolder:firewalla-local-ha}",
        },
      },
      {
        "label": "Pytest",
        "type": "shell",
        "command": "${workspaceFolder:firewalla-local-ha}/.venv/bin/python",
        "args": ["-m", "pytest", "tests/", "-v"],
        "options": {
          "cwd": "${workspaceFolder:firewalla-local-ha}",
        },
        "group": {
          "kind": "test",
          "isDefault": true,
        },
      },
    ],
  },
}

{
  "folders": [
    {
      "path": ".",
    },
    {
      "path": "../core",
    },
  ],
  "settings": {
    "python.defaultInterpreterPath": "/home/vscode/.local/ha-venv/bin/python",
    "python.analysis.exclude": [
      "**/node_modules",
      "**/__pycache__",
      "**/.*",
      "**/.mypy_cache/**",
      "**/.pytest_cache/**",
      "**/.ruff_cache/**",
      "**/.tmp/**",
      "**/site-packages/**",
    ],
    "search.exclude": {
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/.tmp": true,
    },
    "files.exclude": {
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
    },
    "pylint.ignorePatterns": [
      "**/.tmp/**/*.py",
      "**/site-packages/**/*.py",
      "/workspaces/core/**/*.py",
      "/workspaces/firewalla-local-ha/poc.py",
      "/workspaces/firewalla-local-ha/utils/poc.py",
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Auto-Link Firewalla Local",
        "type": "shell",
        "command": "mkdir -p /workspaces/core/config/custom_components && ln -snf /workspaces/firewalla-local-ha/custom_components/firewalla_local /workspaces/core/config/custom_components/firewalla_local",
        "runOptions": {
          "runOn": "folderOpen",
        },
      },
      {
        "label": "Ruff",
        "type": "shell",
        "command": "python -m ruff check .",
      },
      {
        "label": "MyPy",
        "type": "shell",
        "command": "python -m mypy custom_components/firewalla_local",
      },
      {
        "label": "Pytest",
        "type": "shell",
        "command": "python -m pytest tests/ -v",
      },
    ],
  },
}
